# Ignore __pycache__ directories
__pycache__/

# Ignore compiled Python bytecode files
*.pyc

# .vscode folder
.vscode/

#Enquête EUEMR
data/processed/euemr

# One-time pristine copies written by apply_to_sampler's CPT writers
# before they first rewrite a table. Local safety net, regenerated
# automatically; the committed CSV is the one that matters.
*.bak

# Virtual environment (1.1 GB — never commit)
.venv/

# NSRDB solar/weather export, downloaded out-of-band (~100 MB, 480 CSVs).
# Named after the NREL request hash. Regenerate by re-requesting, do not vendor.
22e393a6216edb1d2f9c7f83062bd235/

# Sampler run outputs
Simulations/

